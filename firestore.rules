rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function company(cid) { return get(/databases/$(database)/documents/companies/$(cid)).data; }
    function isMember(cid) { return signedIn() && request.auth.uid in company(cid).members; }
    // getAfter: enxerga a empresa criada no mesmo batch do onboarding.
    function isMemberAfter(cid) { return signedIn() && request.auth.uid in getAfter(/databases/$(database)/documents/companies/$(cid)).data.members; }
    function isOwner(cid) { return signedIn() && company(cid).ownerUid == request.auth.uid; }
    function cents(v) { return v is int && v >= 0 && v <= 100000000000; }
    function isDate(v) { return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'); }
    function str(v, max) { return v is string && v.size() <= max; }

    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    match /companies/{cid} {
      allow read: if isMember(cid)
        || (signedIn() && request.auth.token.email in resource.data.inviteEmails);
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.members == [request.auth.uid]
        && str(request.resource.data.name, 80)
        && cents(request.resource.data.marginCents);
      // Dono altera nome, margem e convites. Máximo 2 pessoas por empresa.
      allow update: if isOwner(cid)
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.members.size() <= 2
        && request.resource.data.inviteEmails.size() <= 1;
      // Convidado só pode se adicionar e consumir o próprio convite.
      allow update: if signedIn()
        && request.auth.token.email in resource.data.inviteEmails
        && resource.data.members.size() < 2
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'inviteEmails'])
        && request.resource.data.members == resource.data.members.concat([request.auth.uid])
        && request.resource.data.inviteEmails == [];

      match /accounts/{id} {
        allow read: if isMember(cid);
        allow create, update: if isMemberAfter(cid)
          && str(request.resource.data.name, 40)
          && request.resource.data.kind in ['operacional', 'reserva']
          && request.resource.data.initialCents is int;
        allow delete: if false;
      }

      match /transactions/{id} {
        allow read: if isMember(cid);
        allow create, update: if isMemberAfter(cid)
          && request.resource.data.type in ['entrada', 'saida', 'transferencia']
          && request.resource.data.status in ['previsto', 'realizado', 'cancelado']
          && cents(request.resource.data.amountCents) && request.resource.data.amountCents > 0
          && cents(request.resource.data.paidCents)
          && request.resource.data.paidCents <= request.resource.data.amountCents
          && isDate(request.resource.data.date)
          && str(request.resource.data.description, 120)
          && str(request.resource.data.category, 40)
          && request.resource.data.updatedBy == request.auth.uid;
        // Excluir é soft delete (deleted: true). Nada some de verdade.
        allow delete: if false;
      }

      match /recurrences/{id} {
        allow read: if isMember(cid);
        allow create, update: if isMemberAfter(cid)
          && request.resource.data.type in ['entrada', 'saida']
          && cents(request.resource.data.amountCents)
          && request.resource.data.dayOfMonth is int
          && request.resource.data.dayOfMonth >= 1 && request.resource.data.dayOfMonth <= 31;
        allow delete: if false;
      }
    }
  }
}
